# Horolog configuration.
# Every value is read with a HOROLOG_ prefix and validated at boot — a bad
# value fails the process rather than the first request that needs it.

# ── Storage ──────────────────────────────────────────────────────────────
# SQLite needs no server and is the default for a single user.
HOROLOG_DATABASE_URL=sqlite+aiosqlite:///./horolog.db
# Postgres (what docker-compose uses):
# HOROLOG_DATABASE_URL=postgresql+asyncpg://horolog:horolog@db:5432/horolog

# ── Scheduling ───────────────────────────────────────────────────────────
# Defaults to the host's own zone. Leaving this at UTC on a machine that is
# not UTC makes a 9-to-5 goal land at 5am, so only set it deliberately.
# HOROLOG_TIMEZONE=America/New_York

HOROLOG_HORIZON_DAYS=21
HOROLOG_WORKDAY_START_MIN=540    # 09:00
HOROLOG_WORKDAY_END_MIN=1020     # 17:00

# Decompression buffers: recovery time held after every meeting between 30
# minutes and 4 hours long. Off by default because it spends real capacity —
# turning it on makes a meeting-heavy week report unmet demand it was already
# quietly failing to deliver.
HOROLOG_AUTO_BUFFER_ENABLED=false
HOROLOG_AUTO_BUFFER_MINUTES=15

# How often connected Google/Outlook calendars re-sync themselves in the
# background, without anyone clicking Sync. ICS and CalDAV aren't covered —
# their credentials are never stored, only passed on the request that syncs
# them — so there's nothing for a background loop to hold onto for those two.
HOROLOG_SYNC_INTERVAL_MINUTES=15

# ── Language model ───────────────────────────────────────────────────────
# `openai` covers every OpenAI-compatible server: Ollama, vLLM, SGLang,
# llama.cpp, OpenAI itself, Groq, Together.
HOROLOG_LLM_PROVIDER=openai
# Left unset here on purpose — the right host depends on how you're running:
#   `npm run dev` (Ollama on your own machine)  -> defaults to http://localhost:11434/v1
#   `docker compose up` (Ollama in its own container) -> defaults to http://ollama:11434/v1
# Uncomment only if you need something other than that default, e.g. a remote server:
# HOROLOG_LLM_BASE_URL=http://localhost:11434/v1
HOROLOG_LLM_MODEL=qwen3:8b
HOROLOG_LLM_API_KEY=
HOROLOG_LLM_TIMEOUT_S=60

# Anthropic (needs the `anthropic` extra, already in the Docker image):
# HOROLOG_LLM_PROVIDER=anthropic
# HOROLOG_LLM_MODEL=claude-opus-5
# HOROLOG_LLM_API_KEY=sk-ant-...

# ── Web ──────────────────────────────────────────────────────────────────
HOROLOG_CORS_ORIGINS=["http://localhost:3000"]

# Where the browser can reach each half directly. Only used to build OAuth
# redirect URLs below: a provider's consent screen sends the browser straight
# back to the API, bypassing the Next.js proxy, so the API needs to know its
# own externally-reachable address. Defaults match `docker compose up` on one
# machine; set both to your real domain for anything beyond that.
# `npm run dev` automatically changes these localhost ports if it has to pick
# free fallback ports. An explicitly exported value is always preserved.
HOROLOG_PUBLIC_API_URL=http://localhost:8000
HOROLOG_PUBLIC_WEB_URL=http://localhost:3000

# ── Calendar & tracker connections (optional) ─────────────────────────────
# Each pair below is an OAuth app you register with the provider yourself —
# self-hosting means this app has no shared client of its own to hand out.
# Leaving a pair blank simply hides that "Connect" button's live state; every
# other feature works without any of these set. Linear, Todoist and GitHub
# also accept a personal API key pasted straight into the Connect page, which
# needs no OAuth app at all.
#
# Google Calendar — console.cloud.google.com → OAuth client (Web application),
# authorized redirect URI {HOROLOG_PUBLIC_API_URL}/api/auth/callback/google
HOROLOG_GOOGLE_CLIENT_ID=
HOROLOG_GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365 — portal.azure.com → App registrations,
# redirect URI {HOROLOG_PUBLIC_API_URL}/api/auth/callback/outlook
HOROLOG_OUTLOOK_CLIENT_ID=
HOROLOG_OUTLOOK_CLIENT_SECRET=

# Linear — linear.app/settings/api/applications,
# redirect URI {HOROLOG_PUBLIC_API_URL}/api/auth/callback/linear
HOROLOG_LINEAR_CLIENT_ID=
HOROLOG_LINEAR_CLIENT_SECRET=

# Todoist — developer.todoist.com/appconsole.html,
# redirect URI {HOROLOG_PUBLIC_API_URL}/api/auth/callback/todoist
HOROLOG_TODOIST_CLIENT_ID=
HOROLOG_TODOIST_CLIENT_SECRET=

# GitHub — github.com/settings/developers → OAuth Apps,
# redirect URI {HOROLOG_PUBLIC_API_URL}/api/auth/callback/github
HOROLOG_GITHUB_CLIENT_ID=
HOROLOG_GITHUB_CLIENT_SECRET=
